# Auto detect text files and perform LF normalization on checkout and commit
* text=auto eol=lf

# Explicit text files
*.rs text diff=rust eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Git hook scripts must strictly retain LF for Linux/macOS execution
.githooks/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg text
*.zip binary
*.xpi binary
*.tar.gz binary
*.dmg binary
*.exe binary
*.msi binary
*.deb binary
*.AppImage binary
*.rpm binary

