{
  "manifest_version": 3,
  "name": "X Download Manager Safari Integration",
  "short_name": "XDM",
  "version": "1.0.0",
  "description": "Intercepts downloads, Usersdrive/authenticated file hosts, and streaming video for X Download Manager on macOS Safari.",
  "author": "~peivee",
  "permissions": [
    "cookies",
    "contextMenus",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "persistent": false
  },
  "action": {
    "default_title": "X Download Manager",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
