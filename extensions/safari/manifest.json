{
  "manifest_version": 3,
  "name": "ByteX Download Manager for Safari",
  "short_name": "ByteX",
  "version": "1.0.0",
  "description": "Capture downloadable files and media with ByteX Download Manager on Safari.",
  "author": "~peivee",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://127.0.0.1:45678/*",
    "http://localhost/*",
    "http://localhost:45678/*"
  ],
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "ByteX Download Manager",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
