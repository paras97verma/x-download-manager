{
  "manifest_version": 3,
  "name": "ByteX Download Manager",
  "short_name": "ByteX",
  "version": "1.0.0",
  "description": "Intercept browser downloads and send authenticated files and media to ByteX Download Manager.",
  "author": "~peivee",
  "browser_specific_settings": {
    "gecko": {
      "id": "xdm-extension@peivee.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "ByteX Download Manager",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    },
    "default_popup": "popup.html"
  }
}
