#!/bin/sh
set -eu
for APP_PATH in "/Applications/ByteX Download Manager.app" "/Applications/X Download Manager.app"; do
  if [ -d "$APP_PATH" ]; then
    /usr/bin/logger "ByteX installer: removing previous application at $APP_PATH"
    APP_EXECUTABLE="$APP_PATH/Contents/MacOS/bytex-download-manager"
    if [ ! -x "$APP_EXECUTABLE" ]; then
      APP_EXECUTABLE="$APP_PATH/Contents/MacOS/x-download-manager"
    fi
    if [ -x "$APP_EXECUTABLE" ]; then
      CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
      if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
        /usr/bin/sudo -H -u "$CONSOLE_USER" "$APP_EXECUTABLE" --prepare-for-update >/dev/null 2>&1 &
      else
        "$APP_EXECUTABLE" --prepare-for-update >/dev/null 2>&1 &
      fi
      attempt=0
      while /usr/bin/pgrep -f "$APP_EXECUTABLE" >/dev/null 2>&1 && [ "$attempt" -lt 5 ]; do
        /bin/sleep 1
        attempt=$((attempt + 1))
      done
      if /usr/bin/pgrep -f "$APP_EXECUTABLE" >/dev/null 2>&1; then
        # Releases before the IPC quit handler need the normal macOS Quit event.
        if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
          /usr/bin/sudo -H -u "$CONSOLE_USER" /usr/bin/osascript -e 'tell application id "com.peivee.xdm" to quit' >/dev/null 2>&1 || true
        fi
      fi
      attempt=0
      while /usr/bin/pgrep -f "$APP_EXECUTABLE" >/dev/null 2>&1 && [ "$attempt" -lt 25 ]; do
        /bin/sleep 1
        attempt=$((attempt + 1))
      done
      if /usr/bin/pgrep -f "$APP_EXECUTABLE" >/dev/null 2>&1; then
        echo "ByteX Download Manager is still running. Quit it and run the installer again." >&2
        exit 1
      fi
    fi
    /bin/rm -rf "$APP_PATH"
  fi
done
exit 0
