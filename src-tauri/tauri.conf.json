{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByteX Download Manager",
  "version": "1.0.2",
  "identifier": "com.peivee.xdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ByteX Download Manager",
        "width": 1024,
        "height": 520,
        "minWidth": 1024,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../extensions/chromium/**/*",
      "../extensions/firefox/**/*",
      "../extensions/safari/**/*"
    ],
    "category": "Utility",
    "shortDescription": "ByteX Download Manager — fast, cross-platform downloads",
    "longDescription": "ByteX Download Manager is a fast, native download manager for macOS, Windows, and Linux, with segmented HTTP/HTTPS downloads, BitTorrent and magnet links, FTP/FTPS, authenticated file hosting, and browser extensions for Chromium, Firefox, and Safari.",
    "copyright": "Copyright © 2026 ~peivee. All rights reserved.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.mac.plist",
      "hardenedRuntime": false
    },
    "windows": {
      "allowDowngrades": true,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "wix": {
        "upgradeCode": "7dfcbae0-cfb4-5c66-91a4-0cadb7fae9a8",
        "language": "en-US"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "conflicts": ["x-download-manager"],
        "replaces": ["x-download-manager"],
        "preInstallScript": "./linux/preinstall.sh"
      },
      "rpm": {
        "obsoletes": ["x-download-manager"],
        "provides": ["x-download-manager"],
        "preInstallScript": "./linux/preinstall.sh"
      }
    }
  }
}
